<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RecipeEditor.Core</RootNamespace>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <!-- ScumModKit: the repository's own submodule (modkit/ next to this folder's parent), else the scum_mod workspace's tools/modkit -->
  <PropertyGroup>
    <ModKitDir Condition="Exists('$(MSBuildThisFileDirectory)..\modkit\ScumModKit.Build\ScumModKit.Build.csproj')">$(MSBuildThisFileDirectory)..\modkit\</ModKitDir>
    <ModKitDir Condition="'$(ModKitDir)' == ''">$(MSBuildThisFileDirectory)..\..\modkit\</ModKitDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <ProjectReference Include="$(ModKitDir)ScumModKit.Build\ScumModKit.Build.csproj" />
    <PackageReference Include="CUE4Parse" Version="1.2.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
