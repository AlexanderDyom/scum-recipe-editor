<Window x:Class="RecipeEditor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RecipeEditor.Gui"
        Style="{StaticResource AppWindow}" Title="SCUM Recipe Editor"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="RemovedEdge" Color="#6A3A33"/>
    <CollectionViewSource x:Key="Recipes">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="GroupTitle"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <DockPanel>
    <!-- top line: projects, current mod, settings -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" ToolTip="{l:T Settings}" Click="Settings_Click">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15"/>
        </Button>
        <Button x:Name="UndoButton" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="0,0,8,0" IsEnabled="False" ToolTip="{l:T UndoTip}" Click="Undo_Click"
                AutomationProperties.Name="{l:T Undo}" ToolTipService.ShowOnDisabled="True">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="15"/>
        </Button>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Btn}" Click="Projects_Click" AutomationProperties.Name="{l:T Projects}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="14" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T Projects}"/>
            </StackPanel>
          </Button>
          <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="12,0" Height="34" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Foreground="{StaticResource Text2}" Margin="0,0,8,0"/>
              <TextBlock x:Name="ProjectName" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock x:Name="ProjectPak" FontSize="12" Foreground="{StaticResource Text2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border x:Name="ReadOnlyBadge" Style="{StaticResource Badge}" Background="{StaticResource WarnBg}" Margin="10,0,0,0" ToolTip="{l:T ReadOnlyTip}">
            <TextBlock Text="{l:T BadgeReadOnly}" Foreground="{StaticResource Warn}" FontSize="11"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <l:GlobalStatus DockPanel.Dock="Bottom"/>

    <!-- project status: unsaved edits, save, build -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Ctrl+S" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="SaveButton" Style="{StaticResource Btn}" IsEnabled="False" Click="Save_Click" AutomationProperties.Name="{l:T Save}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T Save}"/>
            </StackPanel>
          </Button>
          <Button x:Name="BuildButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Build_Click" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{l:T BuildMod}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="14" Foreground="White" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T BuildMod}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ProjectStatusIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
          <TextBlock x:Name="ProjectStatus" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56"/>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- rail -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="0,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <RadioButton x:Name="NavBuild" Style="{StaticResource Rail}" GroupName="nav" Content="&#xE7B8;" ToolTip="{l:T Build}" Click="NavBuild_Click"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Rail}" GroupName="nav" Content="&#xE713;" ToolTip="{l:T Settings}" Click="NavSettings_Click"/>
          </StackPanel>
          <StackPanel>
            <RadioButton x:Name="NavRecipes" Style="{StaticResource Rail}" GroupName="nav" Content="&#xE8A5;" ToolTip="{l:T Recipes}" IsChecked="True" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavBooks" Style="{StaticResource Rail}" GroupName="nav" Content="&#xE82D;" ToolTip="{l:T Books}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavIngredients" Style="{StaticResource Rail}" GroupName="nav" Content="&#xE719;" ToolTip="{l:T Ingredients}" Checked="Nav_Checked"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- recipe list -->
      <Border x:Name="ListPane" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" Tag="{l:T SearchHint}" TextChanged="SearchBox_TextChanged"/>
            <WrapPanel Margin="0,8,0,0">
              <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" GroupName="filter" IsChecked="True" Checked="Chip_Checked"/>
              <RadioButton x:Name="ChipChanged" Style="{StaticResource Chip}" GroupName="filter" Checked="Chip_Checked"/>
              <RadioButton x:Name="ChipNew" Style="{StaticResource Chip}" GroupName="filter" Checked="Chip_Checked"/>
              <RadioButton x:Name="ChipHidden" Style="{StaticResource Chip}" GroupName="filter" Checked="Chip_Checked"/>
            </WrapPanel>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
            <Button x:Name="NewRecipeButton" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Click="NewRecipe_Click" AutomationProperties.Name="{l:T NewRecipe}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T NewRecipe}"/>
              </StackPanel>
            </Button>
          </Border>
          <Grid>
            <ListBox x:Name="RecipeList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RecipeRow}"
                     ItemsSource="{Binding Source={StaticResource Recipes}}" SelectionChanged="RecipeList_SelectionChanged"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <DockPanel Margin="14,10,14,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type l:RecipeRowView}">
                  <Grid ToolTip="{Binding Tip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="5" Background="{StaticResource Slot}">
                      <l:IconView Width="30" Height="30" Texture="{Binding Icon}" Fallback="{Binding Initial}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Line}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{Binding BadgeBg}" Visibility="{Binding BadgeVisibility}">
                      <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="11"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="ListMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
              <TextBlock x:Name="ListMessageTitle" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="ListMessageText" Style="{StaticResource Small}" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- recipe editor -->
      <Grid x:Name="EditorPane" Grid.Column="2">
        <TextBlock x:Name="PickRecipe" Text="{l:T PickRecipe}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <DockPanel x:Name="Editor" Visibility="Collapsed">
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,16,20,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="DishIconBox" Width="76" Height="76" CornerRadius="6" Background="{StaticResource Slot}" BorderBrush="{StaticResource SlotEdge}" BorderThickness="1" MouseLeftButtonUp="DishIcon_Click">
                <l:IconView x:Name="DishIcon" Width="64" Height="64" LetterSize="32"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="RecipeName" FontFamily="{StaticResource CondFont}" FontWeight="SemiBold" FontSize="26" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RecipeSub" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <WrapPanel x:Name="RecipeMeta" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="ModelButton" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Model_Click" AutomationProperties.Name="{l:T ModelButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xF158;" FontSize="14" Margin="0,0,7,0"/>
                  <TextBlock Text="{l:T ModelButton}"/>
                </StackPanel>
              </Button>
              <Button x:Name="ResetButton" Style="{StaticResource Btn}" Click="Reset_Click"
                      ToolTip="{l:T ResetTip}" AutomationProperties.Name="{l:T AsInGame}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="14" Margin="0,0,7,0"/>
                  <TextBlock Text="{l:T AsInGame}"/>
                </StackPanel>
              </Button>
              </StackPanel>
            </Grid>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="20,14,20,20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:T WhereCook}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="Utilities"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{l:T Time}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid>
                      <TextBox x:Name="TimeBox" Style="{StaticResource HintField}" FontSize="13" Padding="8,4,28,4" TextChanged="TimeBox_TextChanged"/>
                      <TextBlock Text="{l:T UnitSeconds}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="TimeNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="{l:T Temperature}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid>
                      <TextBox x:Name="TempBox" Style="{StaticResource HintField}" FontSize="13" Padding="8,4,32,4" Tag="{l:T ByDefault}" TextChanged="TempBox_TextChanged"/>
                      <TextBlock Text="°C" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="TempNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>

                <Border Background="{StaticResource Surface2}" CornerRadius="4,4,0,0" Padding="10,5" Margin="0,18,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{l:T MainHint}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T MainIngredients}"/>
                  </DockPanel>
                </Border>
                <Border Background="{StaticResource Surface}" CornerRadius="0,0,4,4" Padding="8,8,2,2">
                  <WrapPanel x:Name="MainSlots"/>
                </Border>

                <Border Background="{StaticResource Surface2}" CornerRadius="4,4,0,0" Padding="10,5" Margin="0,16,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{l:T OptionalHint}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T OptionalIngredients}"/>
                  </DockPanel>
                </Border>
                <Border Background="{StaticResource Surface}" CornerRadius="0,0,4,4" Padding="8,8,2,2">
                  <WrapPanel x:Name="OptionalSlots"/>
                </Border>

                <TextBlock x:Name="RecipeDescription" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="640"
                           HorizontalAlignment="Left" LineHeight="18"/>
                <TextBlock x:Name="LegendText" Text="{l:T Legend}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="640"
                           HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>

            <!-- inspector: the selected slot and the list of changes -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                  <StackPanel x:Name="Inspector"/>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="{l:T ChangesTitle}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
                      <StackPanel x:Name="Changes"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </DockPanel>
      </Grid>

      <!-- 6. ingredients: every product the recipes use, where it is used (view only) -->
      <Grid x:Name="IngredientsPane" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="310"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
              <TextBox x:Name="IngSearch" Style="{StaticResource SearchField}" Tag="{l:T IngSearchHint}" TextChanged="IngSearch_TextChanged"/>
              <WrapPanel x:Name="IngChips" Margin="0,8,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
              <Button Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Click="NewIngredient_Click" AutomationProperties.Name="{l:T NewIngredient}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{l:T NewIngredient}"/>
                </StackPanel>
              </Button>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="IngList" Margin="0,0,0,8"/></ScrollViewer>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="IngDetail" Margin="22,18,22,18"/></ScrollViewer>
      </Grid>

      <!-- 5. cookbooks: own books, the game's books and "known from the start" (three ways to open a recipe) -->
      <Grid x:Name="BooksPane" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="310"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
              <Button x:Name="NewBookButton" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Click="NewBook_Click" AutomationProperties.Name="{l:T NewBook}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{l:T NewBook}"/>
                </StackPanel>
              </Button>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="BookList" Margin="0,4,0,8"/></ScrollViewer>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid x:Name="BookDetail" Margin="20,16,20,16"/></ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
