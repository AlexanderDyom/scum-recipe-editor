<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ScumRecipeEditor</AssemblyName>
    <RootNamespace>RecipeEditor.Gui</RootNamespace>
    <Version>0.1.2</Version>
    <!-- shown to users; "b" = beta -->
    <InformationalVersion>0.1.2b</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SCUM Recipe Editor</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecipeEditor.Core\RecipeEditor.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="Strings\*.json" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
