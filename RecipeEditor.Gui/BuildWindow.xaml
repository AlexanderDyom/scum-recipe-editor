<Window x:Class="RecipeEditor.Gui.BuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RecipeEditor.Gui"
        Style="{StaticResource AppWindow}" Title="SCUM Recipe Editor"
        Width="740" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
      <DockPanel>
        <Button x:Name="OpenFolderButton" Style="{StaticResource Btn}" Click="OpenFolder_Click" AutomationProperties.Name="{l:T OpenModsFolder}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,7,0"/>
            <TextBlock x:Name="OpenFolderText" Text="{l:T OpenModsFolder}"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Btn}" Content="{l:T Close}" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="BuildButton" Style="{StaticResource Primary}" IsDefault="True" Click="Build_Click" AutomationProperties.Name="{l:T BuildMod}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="14" Foreground="White" Margin="0,0,7,0"/>
              <TextBlock x:Name="BuildButtonText" Text="{l:T BuildMod}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Margin="22,16,22,16">
      <!-- what goes into the mod -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
        <UniformGrid x:Name="Summary" Columns="5"/>
      </Border>

      <TextBlock Text="{l:T ModFileLabel}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,14,0,6"/>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,7">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{l:T ModFileHint}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock x:Name="PakName" FontSize="13"/>
        </DockPanel>
      </Border>

      <CheckBox x:Name="InstallBox" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,14,0,0" Checked="Install_Changed" Unchecked="Install_Changed">
        <TextBlock><Run Text="{l:T InstallAfterBuild}" Foreground="{StaticResource Text}"/> <Run x:Name="ModsPath" Foreground="{StaticResource Muted}" FontSize="12"/></TextBlock>
      </CheckBox>
      <!-- shared registry: done by the installed ScumRegistryMerger; offer to download it when it is missing -->
      <StackPanel x:Name="RegistryPanel" Margin="0,10,0,0">
        <CheckBox x:Name="RegistryBox" Style="{StaticResource Toggle}" IsChecked="True">
          <TextBlock><Run Text="{l:T UpdateRegistry}" Foreground="{StaticResource Text}"/> <Run Text="{l:T UpdateRegistryWhy}" Foreground="{StaticResource Muted}" FontSize="12"/></TextBlock>
        </CheckBox>
        <WrapPanel Margin="40,6,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="MergerState" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="230"/>
          <Border x:Name="MergerNewBadge" Style="{StaticResource Badge}" Background="{StaticResource WarnBg}" Margin="0,0,10,0" Visibility="Collapsed">
            <TextBlock x:Name="MergerNewText" Foreground="{StaticResource Warn}" FontSize="11"/>
          </Border>
          <Button x:Name="MergerActionButton" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,12,0" Click="MergerAction_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,6,0"/>
              <TextBlock x:Name="MergerActionText" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button x:Name="OpenMergerButton" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,12,0" Click="OpenMerger_Click" AutomationProperties.Name="{l:T OpenMerger}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,6,0"/>
              <TextBlock Text="{l:T OpenMerger}" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Link}" Content="github.com/AlexanderDyom/scum-registry-merger" VerticalAlignment="Center" Click="MergerPage_Click"/>
        </WrapPanel>
      </StackPanel>
      <!-- a mod for SCUM Server: what works with the server alone, and the same mod into the SCUM client of this PC -->
      <Border x:Name="ServerPanel" Style="{StaticResource Callout}" Background="{StaticResource WarnBg}" Margin="0,12,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="ServerText" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"/>
          <CheckBox x:Name="AlsoClientBox" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,10,0,0" AutomationProperties.Name="alsoclient">
            <TextBlock Text="{l:T AlsoClient}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
          </CheckBox>
        </StackPanel>
      </Border>
      <StackPanel x:Name="FolderPanel" Visibility="Collapsed" Margin="0,10,0,0">
        <TextBlock Text="{l:T SaveToFolder}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BrowseFolder_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T Browse}"/>
            </StackPanel>
          </Button>
          <TextBox x:Name="FolderBox" Style="{StaticResource Field}" FontSize="12"/>
        </DockPanel>
        <TextBlock x:Name="FolderHint" Style="{StaticResource Small}" Margin="0,6,0,0"/>
      </StackPanel>

      <Border x:Name="GameRunningBanner" Style="{StaticResource Callout}" Background="{StaticResource DangerBg}" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Text="{l:T GameRunningBuild}" Foreground="{StaticResource DangerText}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <StackPanel x:Name="Steps" Margin="0,14,0,0"/>

      <!-- the shared registry has issues: the merger's window shows each mod (e.g. built for another game version) -->
      <Border x:Name="RegistryHelp" Style="{StaticResource Callout}" Background="{StaticResource WarnBg}" Margin="0,12,0,0" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="10,0,0,0" Padding="10,5" Click="OpenMerger_Click"
                  AutomationProperties.Name="{l:T OpenMerger}">
            <TextBlock Text="{l:T OpenMerger}" FontSize="12"/>
          </Button>
          <TextBlock Text="{l:T RegistryHelp}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border x:Name="SpawnPanel" Style="{StaticResource Callout}" Background="{StaticResource AccentBg}" Margin="0,12,0,0" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="10,0,0,0" Padding="10,5" Click="CopySpawn_Click"
                  AutomationProperties.Name="{l:T CopyCommands}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,6,0"/>
              <TextBlock x:Name="CopyText" Text="{l:T CopyCommands}" FontSize="12"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="{l:T SpawnTitle}" Foreground="{StaticResource AccentText}" FontSize="12" Margin="0,0,0,4"/>
            <TextBlock x:Name="SpawnText" Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
