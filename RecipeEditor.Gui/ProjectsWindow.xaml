<Window x:Class="RecipeEditor.Gui.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RecipeEditor.Gui"
        Style="{StaticResource AppWindow}" Title="SCUM Recipe Editor"
        Width="1100" Height="640" MinWidth="900" MinHeight="520" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- top line: which game, key badge, settings -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" ToolTip="{l:T Settings}" Click="Settings_Click">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="GameLine" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center"/>
          <Border Style="{StaticResource Badge}" Background="{StaticResource OkBg}" Margin="10,0,0,0" ToolTip="{l:T BadgeKeyTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="10" Foreground="{StaticResource Ok}" Margin="0,0,4,0"/>
              <TextBlock Text="{l:T BadgeKey}" Foreground="{StaticResource Ok}" FontSize="11"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <l:GlobalStatus DockPanel.Dock="Bottom"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- project list -->
      <DockPanel Margin="22,18,22,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OpenFolder_Click" AutomationProperties.Name="{l:T OpenFolder}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T OpenFolder}"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{l:T Projects}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsEnabled="False" Click="Open_Click"/>
          <TextBlock Style="{StaticResource Small}" Text="{l:T ProjectsHint}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ProjectRow}"
                   SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type l:ProjectRowView}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="130"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="5" Background="{StaticResource Slot}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="18" Foreground="{StaticResource Text2}" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FileLine}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Stats}" FontSize="12"/>
                    <TextBlock Text="{Binding Stats2}" FontSize="12" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Background="{Binding BadgeBg}" ToolTip="{Binding BadgeTip}">
                      <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Visibility="Collapsed">
            <TextBlock Text="{l:T NoProjectsTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Small}" Text="{l:T NoProjectsText}" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- new project -->
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,18">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" x:Name="CreateButton" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" IsEnabled="False" Click="Create_Click" AutomationProperties.Name="{l:T CreateProject}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T CreateProject}"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="{l:T NewProject}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TextBlock Text="{l:T ModName}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Style="{StaticResource HintField}" FontSize="13" Padding="8,4" Tag="{l:T NameHint}" TextChanged="NameBox_TextChanged"/>
            <TextBlock x:Name="Derived" FontSize="12" Foreground="{StaticResource Text2}" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="{l:T ProjectFolder}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,14,0,6"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="6,0,0,0" ToolTip="{l:T Browse}" Click="BrowseRoot_Click">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14"/>
              </Button>
              <TextBox x:Name="FolderBox" Style="{StaticResource Field}" IsReadOnly="True" Foreground="{StaticResource Text2}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
              <TextBlock Text="{l:T Description}" Foreground="{StaticResource Text2}" FontSize="12"/>
              <TextBlock Text="{l:T Optional}" Foreground="{StaticResource Muted}" FontSize="12" Margin="5,0,0,0"/>
            </StackPanel>
            <TextBox x:Name="DescriptionBox" Style="{StaticResource HintField}" FontSize="13" Padding="8,4" Tag="{l:T DescriptionHint}"/>
            <Border Style="{StaticResource Callout}" Background="{StaticResource AccentBg}" Margin="0,16,0,0">
              <TextBlock Text="{l:T ProjectInfo}" Foreground="{StaticResource AccentText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
