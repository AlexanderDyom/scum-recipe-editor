<Window x:Class="RecipeEditor.Gui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RecipeEditor.Gui"
        Style="{StaticResource AppWindow}" Title="SCUM Recipe Editor"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24,16,24,20">
    <DockPanel>
      <ComboBox x:Name="LangBox" DockPanel.Dock="Right" Width="210" VerticalAlignment="Top" SelectionChanged="LangBox_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="{x:Type l:LangOption}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Text}"/>
              <TextBlock Text="AI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="6,0,0,0"
                         Visibility="{Binding AiVisibility}" ToolTip="{l:T AiTip}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Text="{l:T SetupTitle}" Margin="0,4,0,4"/>
        <TextBlock Style="{StaticResource Small}" Text="{l:T SetupSubtitle}" MaxWidth="300" HorizontalAlignment="Left"/>
      </StackPanel>
    </DockPanel>

    <TextBlock Text="{l:T GameWhere}" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8"/>
    <UniformGrid Columns="2">
      <RadioButton x:Name="ClientCard" Style="{StaticResource Card}" GroupName="kind" Margin="0,0,5,0" Checked="Kind_Checked">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Margin="0,0,8,0"/>
            <TextBlock Text="{l:T Client}" FontSize="14"/>
          </StackPanel>
          <TextBlock x:Name="ClientFound" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="ServerCard" Style="{StaticResource Card}" GroupName="kind" Margin="5,0,0,0" Checked="Kind_Checked">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Margin="0,0,8,0"/>
            <TextBlock Text="{l:T Server}" FontSize="14"/>
          </StackPanel>
          <TextBlock x:Name="ServerFound" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </RadioButton>
    </UniformGrid>
    <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Browse_Click" AutomationProperties.Name="{l:T Browse}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0"/>
          <TextBlock Text="{l:T Browse}"/>
        </StackPanel>
      </Button>
      <TextBox x:Name="PathBox" Style="{StaticResource Field}" FontSize="13" TextChanged="PathBox_TextChanged"/>
    </DockPanel>
    <TextBlock x:Name="PathStatus" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
      <TextBlock Text="{l:T AesKey}" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource Small}" Text="{l:T Required}" Margin="7,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
    </StackPanel>
    <Grid>
      <PasswordBox x:Name="KeyBox" Style="{StaticResource KeyField}" FontSize="13" Padding="8,7" PasswordChanged="KeyBox_PasswordChanged"/>
      <TextBlock x:Name="KeyHint" Text="{l:T KeyHint}" Foreground="{StaticResource Muted}" FontSize="13" Margin="11,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock x:Name="KeyStatus" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <Border x:Name="KeyCallout" Style="{StaticResource Callout}" Background="{StaticResource DangerBg}" Margin="0,10,0,0">
      <TextBlock Text="{l:T KeyRequired}" Foreground="{StaticResource DangerText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
    </Border>

    <DockPanel Margin="0,20,0,0">
      <Button DockPanel.Dock="Right" x:Name="ContinueButton" Style="{StaticResource Primary}" Content="{l:T Continue}" IsDefault="True"
              IsEnabled="False" Click="Continue_Click"/>
      <Button Style="{StaticResource Link}" Content="{l:T WhereKey}" VerticalAlignment="Center" HorizontalAlignment="Left" Click="WhereKey_Click"/>
    </DockPanel>
  </StackPanel>
</Window>
